# Copy to .env.local. Keep real values out of Git.
# Client configuration: a public URL, never an administrator token.
VITE_COMPANION_URL=
VITE_BACKEND_URL=
# Optional TV bootstrap; stored in the generated private widget, not the web bundle.
IPTV_URL=
IPTV_USERNAME=
IPTV_PASSWORD=
TMDB_API_KEY=
# Companion deployment: configure these in the hosting environment as well.
COMPANION_PUBLIC_URL=
BURHANTV_ASSISTANT_KEY=
# Optional registered ChatGPT app dependency, used only by plugin:build.
CHATGPT_APP_ID=
# Local server / LAN relay
PORT=3000
HOST=127.0.0.1
LINK_PORT=8796
LINK_HOST=127.0.0.1
LINK_PUBLIC_URL=
